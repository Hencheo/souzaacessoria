---
import { Image } from 'astro:assets';
import { SITE } from '../site.config';
import WhatsIcon from './WhatsIcon.astro';
import foto from '../assets/advogada-avatar.jpg';

const nome = SITE.advogada.replace('Dra. ', '').split(' ')[0];
---

<div class="zap" data-zap>
  <!-- Cartão estilo conversa do WhatsApp (só no PC) -->
  <div class="zap__cartao" id="zap-cartao" role="dialog" aria-label={`Mensagem de ${SITE.advogada}`} hidden>
    <div class="zap__topo">
      <Image class="zap__avatar" src={foto} alt="" width={96} height={96}/>
      <div class="zap__quem">
        <strong>{SITE.advogada}</strong>
        <span><i></i> online</span>
      </div>
      <button class="zap__fechar" type="button" aria-label="Fechar mensagem" data-zap-fechar>
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linecap="round" /></svg>
      </button>
    </div>

    <div class="zap__conversa">
      <div class="zap__digitando" aria-hidden="true"><span></span><span></span><span></span></div>
      <div class="zap__balao">
        <p>Oi, tudo bem? Aqui é a {nome}. 😊</p>
        <p>Será um prazer te atender. Me conta aqui o que está acontecendo?</p>
        <time>agora</time>
      </div>
    </div>

    <a class="zap__responder" href={SITE.whatsapp} target="_blank" rel="noopener">
      <span>Escreva sua mensagem…</span>
      <span class="zap__enviar"><WhatsIcon /></span>
    </a>
  </div>

  <a class="whats" href={SITE.whatsapp} target="_blank" rel="noopener" aria-label="Agendar atendimento pelo WhatsApp" aria-controls="zap-cartao" aria-expanded="false" data-zap-botao>
    <span class="whats__icone"><WhatsIcon /><span class="whats__badge" aria-hidden="true">1</span></span>
    <span class="whats__texto">Agendar</span>
    <span class="whats__dica" aria-hidden="true">Posso te ajudar?</span>
  </a>
</div>

<style>
  .zap {
    position: fixed;
    right: max(1rem, env(safe-area-inset-right));
    bottom: max(1rem, env(safe-area-inset-bottom));
    z-index: 60;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.9rem;
  }

  .whats {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.4rem;
    border-radius: 999px;
    background: var(--noite);
    border: 1px solid rgba(194, 160, 106, 0.45);
    color: var(--papel);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.9rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.25);
    transition: transform 0.35s var(--ease), border-color 0.35s var(--ease);
  }
  .whats:hover { transform: translateY(-2px); border-color: var(--ouro); color: var(--papel); }
  .whats__icone {
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    background: #25d366;
    color: #fff;
    display: grid;
    place-items: center;
  }
  .whats__icone :global(svg) { width: 1.45rem; height: 1.45rem; }
  .whats__texto { display: none; padding-right: 0.9rem; }
  @media (min-width: 760px) { .whats__texto { display: inline; } }
  .whats__icone { position: relative; }

  /* Selo de mensagem não lida */
  .whats__badge {
    position: absolute;
    top: -3px;
    right: -3px;
    min-width: 1.15rem;
    height: 1.15rem;
    border-radius: 999px;
    background: #e5484d;
    color: #fff;
    font-size: 0.68rem;
    font-weight: 700;
    display: grid;
    place-items: center;
    border: 2px solid var(--noite);
    transform: scale(0);
    transition: transform 0.35s var(--ease);
  }
  .zap.tem-msg .whats__badge { transform: scale(1); }

  /* Chamada periódica: o botão se expande com uma frase e pulsa */
  .whats__dica {
    max-width: 0;
    overflow: hidden;
    white-space: nowrap;
    opacity: 0;
    transition: max-width 0.6s var(--ease), opacity 0.4s var(--ease), padding 0.6s var(--ease);
  }
  .zap.chama .whats__texto { display: none; }
  .zap.chama .whats__dica { max-width: 12rem; opacity: 1; padding-right: 0.9rem; }
  .zap.chama .whats__icone::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 2px solid #25d366;
    animation: zap-onda 1.6s var(--ease) 2;
  }
  @keyframes zap-onda { from { transform: scale(1); opacity: 0.8; } to { transform: scale(1.7); opacity: 0; } }
  .zap__cartao { max-width: calc(100vw - 2rem); }

  /* Cartão */
  .zap__cartao {
    width: 21rem;
    border-radius: 18px;
    overflow: hidden;
    background: #efeae2;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.35), 0 0 0 1px rgba(0, 0, 0, 0.06);
    transform-origin: bottom right;
    animation: zap-entra 0.45s var(--ease) both;
    font-family: var(--sans);
  }
  .zap__cartao[hidden] { display: none; }
  @keyframes zap-entra {
    from { opacity: 0; transform: translateY(12px) scale(0.92); }
    to { opacity: 1; transform: none; }
  }

  .zap__topo { display: flex; align-items: center; gap: 0.75rem; padding: 0.85rem 0.9rem; background: var(--noite); color: var(--papel); }
  .zap__topo :global(.zap__avatar) { width: 2.6rem; height: 2.6rem; border-radius: 50%; object-fit: cover; object-position: top; border: 1px solid rgba(194, 160, 106, 0.6); }
  .zap__quem { display: flex; flex-direction: column; line-height: 1.25; flex: 1; min-width: 0; }
  .zap__quem strong { font-size: 0.92rem; font-weight: 600; }
  .zap__quem span { font-size: 0.75rem; color: var(--mudo-escuro); display: flex; align-items: center; gap: 0.35rem; }
  .zap__quem i { width: 7px; height: 7px; border-radius: 50%; background: #25d366; }
  .zap__fechar { background: none; border: 0; color: var(--mudo-escuro); cursor: pointer; padding: 0.3rem; border-radius: 50%; display: grid; }
  .zap__fechar:hover { color: var(--papel); }

  .zap__conversa {
    padding: 1.1rem 0.9rem 1.2rem;
    min-height: 7.5rem;
    background-color: #efeae2;
    background-image: radial-gradient(rgba(0, 0, 0, 0.035) 1px, transparent 1px);
    background-size: 14px 14px;
  }
  .zap__balao {
    position: relative;
    max-width: 88%;
    background: #fff;
    color: #111b21;
    padding: 0.55rem 0.75rem 1.2rem;
    border-radius: 0 10px 10px 10px;
    font-size: 0.9rem;
    line-height: 1.45;
    box-shadow: 0 1px 1px rgba(0, 0, 0, 0.08);
    animation: zap-entra 0.35s var(--ease) both;
  }
  .zap__balao::before {
    content: '';
    position: absolute;
    left: -7px;
    top: 0;
    border-top: 8px solid #fff;
    border-left: 8px solid transparent;
  }
  .zap__balao p { margin: 0 0 0.35rem; }
  .zap__balao p:last-of-type { margin: 0; }
  .zap__balao time { position: absolute; right: 0.6rem; bottom: 0.3rem; font-size: 0.68rem; color: #667781; }

  .zap__digitando {
    display: inline-flex;
    gap: 4px;
    background: #fff;
    padding: 0.7rem 0.85rem;
    border-radius: 0 10px 10px 10px;
    box-shadow: 0 1px 1px rgba(0, 0, 0, 0.08);
  }
  .zap__digitando span { width: 6px; height: 6px; border-radius: 50%; background: #8696a0; animation: zap-pulo 1.1s infinite; }
  .zap__digitando span:nth-child(2) { animation-delay: 0.15s; }
  .zap__digitando span:nth-child(3) { animation-delay: 0.3s; }
  @keyframes zap-pulo { 0%, 60%, 100% { transform: none; opacity: 0.5; } 30% { transform: translateY(-3px); opacity: 1; } }

  /* Antes da mensagem chegar: mostra "digitando…" */
  .zap__cartao:not(.chegou) .zap__balao { display: none; }
  .zap__cartao.chegou .zap__digitando { display: none; }

  .zap__responder {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.6rem 0.6rem 0.6rem 1rem;
    background: #f0f2f5;
    text-decoration: none;
    color: #667781;
    font-size: 0.88rem;
  }
  .zap__responder > span:first-child { flex: 1; background: #fff; border-radius: 999px; padding: 0.6rem 0.9rem; }
  .zap__enviar { width: 2.5rem; height: 2.5rem; border-radius: 50%; background: #25d366; color: #fff; display: grid; place-items: center; transition: transform 0.3s var(--ease); }
  .zap__enviar :global(svg) { width: 1.2rem; height: 1.2rem; }
  .zap__responder:hover .zap__enviar { transform: scale(1.06); }
  .zap__responder:hover > span:first-child { color: #111b21; }

  @media (prefers-reduced-motion: reduce) {
    .zap__cartao, .zap__balao { animation: none; }
    .zap__digitando span { animation: none; }
  }
</style>

<script>
  const PC = window.matchMedia('(min-width: 760px)');
  const raiz = document.querySelector('[data-zap]');
  const cartao = raiz?.querySelector<HTMLElement>('#zap-cartao');
  const botao = raiz?.querySelector<HTMLAnchorElement>('[data-zap-botao]');
  const fechar = raiz?.querySelector<HTMLButtonElement>('[data-zap-fechar]');
  let timer: number | undefined;

  const lembrar = (chave: string, valor?: string) => {
    try {
      if (valor === undefined) return sessionStorage.getItem(chave);
      sessionStorage.setItem(chave, valor);
    } catch {}
    return null;
  };

  const abrir = () => {
    if (!cartao || !botao) return;
    cartao.hidden = false;
    cartao.classList.remove('chegou');
    botao.setAttribute('aria-expanded', 'true');
    clearTimeout(timer);
    raiz?.classList.remove('chama', 'tem-msg');
    timer = window.setTimeout(() => cartao.classList.add('chegou'), 1300);
  };
  const fecharCartao = () => {
    if (!cartao || !botao) return;
    cartao.hidden = true;
    botao.setAttribute('aria-expanded', 'false');
    if (cartao.classList.contains('chegou')) raiz?.classList.add('tem-msg');
    lembrar('zap-fechado', '1');
  };

  // Enquanto o cartão estiver fechado, o botão se expande de tempos em tempos.
  const chamar = () => {
    if (!cartao?.hidden || document.hidden) return;
    raiz?.classList.add('chama');
    window.setTimeout(() => raiz?.classList.remove('chama'), 4500);
  };
  window.setInterval(chamar, 18000);
  window.setTimeout(chamar, PC.matches ? 20000 : 5000);

  // O botão abre e fecha o cartão; dentro dele, o link leva ao WhatsApp.
  botao?.addEventListener('click', (e) => {
    e.preventDefault();
    cartao?.hidden ? abrir() : fecharCartao();
  });
  fechar?.addEventListener('click', fecharCartao);
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && cartao && !cartao.hidden) fecharCartao(); });

  // Abre sozinho uma vez por visita, alguns segundos depois de chegar.
  if (PC.matches && !lembrar('zap-fechado')) {
    window.setTimeout(() => { if (cartao?.hidden && !lembrar('zap-fechado')) abrir(); }, 6000);
  }
</script>
