---
// Lista editorial numerada (mesmo estilo do índice da página inicial).
interface Props {
  itens: { t: string; d?: string; href: string }[];
  inicio?: number;
}
const { itens, inicio = 1 } = Astro.props;
---

<ul class="indice-lista">
  {itens.map((i, k) => (
    <li>
      <a class="indice-linha" href={i.href}>
        <span class="indice-linha__n">{String(inicio + k).padStart(2, '0')}</span>
        <span class="indice-linha__t">{i.t}</span>
        {i.d && <span class="indice-linha__d">{i.d}</span>}
        <span class="indice-linha__seta" aria-hidden="true">→</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .indice-lista { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--tinta); }
  .indice-linha {
    display: grid;
    grid-template-columns: 2.6rem 1fr 1.5rem;
    grid-template-areas: 'n t s' 'n d s';
    column-gap: 1rem;
    align-items: center;
    padding: 1.35rem 0;
    border-bottom: 1px solid var(--linha);
    text-decoration: none;
    color: inherit;
    position: relative;
  }
  .indice-linha::before {
    content: '';
    position: absolute;
    left: 0;
    bottom: -1px;
    height: 1px;
    width: 100%;
    background: var(--ouro-texto);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.6s var(--ease);
  }
  .indice-linha:hover::before { transform: scaleX(1); }
  .indice-linha__n { grid-area: n; font-family: var(--serif); font-size: 1.05rem; color: var(--ouro-texto); align-self: start; padding-top: 0.25rem; }
  .indice-linha__t { grid-area: t; font-family: var(--serif); font-size: clamp(1.2rem, 1.9vw, 1.45rem); line-height: 1.3; color: var(--tinta); transition: transform 0.5s var(--ease); }
  .indice-linha__d { grid-area: d; font-size: 0.9rem; line-height: 1.55; color: var(--mudo); margin-top: 0.3rem; max-width: 40rem; }
  .indice-linha__seta { grid-area: s; color: var(--ouro-texto); font-size: 1.2rem; transition: transform 0.5s var(--ease); }
  .indice-linha:hover .indice-linha__t { transform: translateX(6px); }
  .indice-linha:hover .indice-linha__seta { transform: translateX(4px); }
  @media (max-width: 640px) {
    .indice-linha { grid-template-columns: 2rem 1fr 1.2rem; column-gap: 0.8rem; padding: 1.15rem 0; }
  }
</style>
