---
import { NAV, SITE } from '../site.config';
import WhatsIcon from './WhatsIcon.astro';
import Marca from './Marca.astro';

const atual = Astro.url.pathname;
const ativo = (href: string) => (href === '/' ? atual === '/' : atual.startsWith(href));
const links = NAV.filter((i) => i.href !== '/');
---

<header class="topo">
  <div class="container topo__linha">
    <Marca />

    <div class="menu">
      <button class="menu__botao" type="button" aria-label="Abrir menu" aria-expanded="false" aria-controls="nav-principal">
        <span></span><span></span>
      </button>
      <nav id="nav-principal" aria-label="Principal">
        <ul>
          {links.map((i) => (
            <li><a href={i.href} aria-current={ativo(i.href) ? 'page' : undefined}>{i.label}</a></li>
          ))}
        </ul>
        <a class="botao botao--ouro menu__cta" href={SITE.whatsapp} target="_blank" rel="noopener">
          <WhatsIcon /> Agendar
        </a>
      </nav>
    </div>
  </div>
</header>

<style>
  .topo {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(21, 21, 23);
    border-bottom: 1px solid var(--linha-escura);
  }
  .topo__linha { display: flex; align-items: center; justify-content: space-between; min-height: 4rem; }
  @media (min-width: 980px) { .topo__linha { min-height: 4.75rem; } }

  .menu__botao {
    cursor: pointer;
    width: 2.5rem;
    height: 2.5rem;
    display: grid;
    place-content: center;
    gap: 6px;
    background: none;
    border: 0;
    padding: 0;
    margin-right: -0.5rem;
  }
  .menu__botao span { display: block; width: 20px; height: 1px; background: var(--papel); transition: transform 0.35s var(--ease); }
  .menu.aberto .menu__botao span:first-child { transform: translateY(3.5px) rotate(45deg); }
  .menu.aberto .menu__botao span:last-child { transform: translateY(-3.5px) rotate(-45deg); }

  /* celular: painel compacto e translúcido logo abaixo do topo */
  .menu nav { display: none; }
  .menu.aberto nav {
    display: block;
    position: absolute;
    top: calc(100% + 0.5rem);
    right: var(--gutter);
    width: min(16rem, calc(100vw - 2 * var(--gutter)));
    padding: 0.5rem 1.1rem 1.1rem;
    border-radius: 14px;
    background: rgba(21, 21, 23, 0.72);
    backdrop-filter: blur(18px) saturate(140%);
    -webkit-backdrop-filter: blur(18px) saturate(140%);
    border: 1px solid rgba(255, 255, 255, 0.08);
    box-shadow: 0 18px 40px rgba(0, 0, 0, 0.3);
    transform-origin: top right;
    animation: menu-entra 0.3s var(--ease) both;
  }
  @keyframes menu-entra { from { opacity: 0; transform: translateY(-6px) scale(0.97); } to { opacity: 1; transform: none; } }
  .menu ul { list-style: none; margin: 0 0 0.9rem; padding: 0; }
  .menu li a {
    display: block;
    padding: 0.7rem 0;
    text-decoration: none;
    font-size: 0.95rem;
    color: #e6e2ea;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  }
  .menu li:last-child a { border-bottom: 0; }
  .menu a[aria-current='page'] { color: var(--ouro); }
  .menu__cta { width: 100%; justify-content: center; padding: 0.7rem 1rem; font-size: 0.88rem; }

  @media (min-width: 980px) {
    .menu__botao { display: none; }
    .menu nav, .menu.aberto nav {
      position: static;
      display: flex;
      align-items: center;
      gap: 2.2rem;
      width: auto;
      padding: 0;
      background: none;
      border: 0;
      border-radius: 0;
      box-shadow: none;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
      animation: none;
    }
    .menu ul { display: flex; gap: 2rem; margin: 0; }
    .menu li a {
      font-family: var(--sans);
      font-size: 0.88rem;
      letter-spacing: 0.04em;
      color: #d8d4dc;
      border: 0;
      padding: 0.3rem 0;
      font-size: 0.88rem;
      position: relative;
    }
    .menu li a::after {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      bottom: -2px;
      height: 1px;
      background: var(--ouro);
      transform: scaleX(0);
      transform-origin: left;
      transition: transform 0.4s var(--ease);
    }
    .menu li a:hover, .menu a[aria-current='page'] { color: var(--papel); }
    .menu li a:hover::after, .menu li a[aria-current='page']::after { transform: scaleX(1); }
    .menu__cta { width: auto; padding: 0.65rem 1.2rem; font-size: 0.85rem; }
  }
</style>

<script>
  const menu = document.querySelector('.menu');
  const botao = document.querySelector<HTMLButtonElement>('.menu__botao');
  const alternar = (abrir: boolean) => {
    menu?.classList.toggle('aberto', abrir);
    botao?.setAttribute('aria-expanded', String(abrir));
    botao?.setAttribute('aria-label', abrir ? 'Fechar menu' : 'Abrir menu');
  };
  botao?.addEventListener('click', () => alternar(!menu?.classList.contains('aberto')));
  document.querySelectorAll('.menu nav a').forEach((a) => a.addEventListener('click', () => alternar(false)));
  document.addEventListener('click', (e) => { if (menu?.classList.contains('aberto') && !menu.contains(e.target as Node)) alternar(false); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') alternar(false); });
</script>
