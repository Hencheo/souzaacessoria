---
import { SITE } from '../site.config';
import WhatsIcon from './WhatsIcon.astro';

interface Props { titulo?: string }
const { titulo } = Astro.props;
---

<section class="chamada">
  <div class="container chamada__grade">
    <div>
      <p class="rotulo">Agendamento</p>
      {titulo ? <h2>{titulo}</h2> : <h2>Vamos conversar sobre o <em>seu caso</em>?</h2>}
    </div>
    <div class="chamada__acoes">
      <p>Atendimento com hora marcada em Maringá e região, presencial ou on-line.</p>
      <a class="botao botao--ouro" href={SITE.whatsapp} target="_blank" rel="noopener">
        <WhatsIcon /> Agendar pelo WhatsApp
      </a>
      <a class="chamada__tel" href={`tel:${SITE.telefoneE164}`}>ou ligue {SITE.telefone}</a>
    </div>
  </div>
</section>

<style>
  .chamada {
    background:
      radial-gradient(ellipse 50% 80% at 15% 100%, var(--brilho), transparent 70%),
      var(--noite);
    color: var(--mudo-escuro);
    padding: clamp(4.5rem, 10vw, 8rem) 0;
  }
  .chamada .rotulo { color: var(--ouro); }
  .chamada h2 { color: var(--papel); font-size: clamp(2.4rem, 5.5vw, 4.4rem); max-width: 14ch; margin: 0; }
  .chamada h2 :global(em) { color: var(--ouro); }
  .chamada__grade { display: grid; gap: 2.5rem; align-items: end; }
  @media (min-width: 900px) { .chamada__grade { grid-template-columns: 1.4fr 1fr; gap: 4rem; } }
  .chamada__acoes { display: flex; flex-direction: column; align-items: flex-start; gap: 1.1rem; }
  .chamada__acoes p { margin: 0 0 0.4rem; max-width: 26rem; }
  .chamada__tel { color: var(--mudo-escuro); font-size: 0.9rem; }
  .chamada__tel:hover { color: var(--ouro); }
</style>
